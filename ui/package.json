{
  "name": "@typing-trainer/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc --project tsconfig.json --watch --noEmit",
    "build": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
